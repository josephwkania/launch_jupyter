#!/bin/bash
#SBATCH --job-name=jupyter
#SBATCH --partition=jupyter,main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=jupyter-%j.log
#
# launch_jupyter - start JupyterLab on a Slurm compute node and print the
# SSH tunnel command and URL needed to reach it.
#
# Use it either way:
#   launch_jupyter [options]     submit, wait, and print connection details
#   sbatch launch_jupyter        plain batch job; details are in jupyter-<jobid>.log
#
# Copyright (C) 2025-2026 Joseph Kania
# Originally based on https://github.com/devanshkv/bowser_slurm_tutorial (GPL-3.0)
#
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the Free
# Software Foundation, either version 3 of the License, or (at your option)
# any later version. See the LICENSE file for details.

set -euo pipefail

LJ_VERSION="1.3.1"
PROG="launch_jupyter"

die() {
    echo "${PROG}: error: $*" >&2
    exit 1
}

# Print $* in bold when stdout is a terminal (and NO_COLOR is not set), so
# the lines to copy stand out; logs and pipes get plain text.
bold() {
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
        printf '\033[1m%s\033[0m\n' "$*"
    else
        printf '%s\n' "$*"
    fi
}

usage() {
    cat <<EOF
Usage: ${PROG} [options] [-- extra sbatch options]

Start JupyterLab on a Slurm compute node and print how to connect to it, or
with --vscode, hold a compute node for a VS Code Remote-SSH session.

Options:
      --vscode          Hold a node for VS Code Remote-SSH instead of
                        starting Jupyter
  -c, --cpus N          CPUs for the job              (default: ${LJ_CPUS})
  -m, --mem SIZE        Memory, e.g. 32G              (default: ${LJ_MEM})
  -t, --time TIME       Time limit, e.g. 4:00:00      (default: ${LJ_TIME})
  -p, --partition LIST  Slurm partition(s)            (default: ${LJ_PARTITION})
  -M, --module NAME     Module to load if jupyter-lab is not already on PATH
                                                      (default: ${LJ_MODULE:-none})
  -w, --wait SECONDS    How long to wait for Jupyter to start (default: ${LJ_WAIT})
  -i, --idle-timeout MIN
                        Stop Jupyter (and end the job) after MIN minutes with
                        no activity; 0 turns this off (default: ${LJ_IDLE_TIMEOUT})
  -l, --list            Show your running sessions and how to connect to them
  -s, --stop [JOBID]    Stop a session (the only one, if JOBID is left out)
      --stop-all        Stop all your jupyter and vscode sessions
  -h, --help           Show this help
  -V, --version         Show the version

Anything after '--' is passed to sbatch unchanged, e.g. -- --account=myproj

If jupyter-lab is on your PATH (for example, an activated conda env), the job
uses that environment. Otherwise it loads the module above.

The script can also be submitted directly: 'sbatch ${PROG}' (or
'sbatch ${PROG} --vscode'). The connection details are then written to
jupyter-<jobid>.log in the submit directory.

In --vscode mode, VS Code server processes on the node are stopped when the
job ends, so save your work before the time limit.

Settings are read from $(tilde "${LJ_SCRIPT_HOME:-<script dir>}/config.sh") (site defaults),
then $(tilde "$(user_config_path)") (yours, if it exists).
Options override both.
EOF
}

# Show a path with $HOME written as ~.
tilde() {
    local path="$1"
    if [[ -n "${HOME:-}" && "${path}" == "${HOME}"/* ]]; then
        echo "~${path#"${HOME}"}"
    else
        echo "${path}"
    fi
}

user_config_path() {
    echo "${LAUNCH_JUPYTER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/launch_jupyter/config.sh}"
}

# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------

# Load site config (next to the real script), then the user's config, then
# fill in anything still unset with built-in defaults.
load_config() {
    local script_dir="$1"
    local user_config
    user_config=$(user_config_path)

    if [[ -n "${script_dir}" && -r "${script_dir}/config.sh" ]]; then
        # shellcheck source=/dev/null
        source "${script_dir}/config.sh"
    fi
    if [[ -r "${user_config}" ]]; then
        # shellcheck source=/dev/null
        source "${user_config}"
    elif [[ -n "${LAUNCH_JUPYTER_CONFIG:-}" ]]; then
        die "LAUNCH_JUPYTER_CONFIG is set but '${LAUNCH_JUPYTER_CONFIG}' is not readable"
    fi

    : "${LJ_PARTITION:=jupyter,main}"
    : "${LJ_CPUS:=8}"
    : "${LJ_MEM:=64G}"
    : "${LJ_TIME:=12:00:00}"
    : "${LJ_MODULEPATH:=}"
    : "${LJ_MODULE:=}"
    : "${LJ_LOGIN_HOST:=}"
    : "${LJ_SSH_HOST_PATTERN:=}"
    : "${LJ_LOG_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/launch_jupyter}"
    : "${LJ_WAIT:=600}"
    : "${LJ_IDLE_TIMEOUT:=0}"
}

# Path of a job's output file, as Slurm reports it.
job_log_path() {
    scontrol show job "$1" 2>/dev/null | grep -oE 'StdOut=[^ ]+' | head -n1 | cut -d= -f2- || true
}

# When a job will hit its time limit, as "YYYY-MM-DD HH:MM", or nothing if
# Slurm does not know yet (e.g. still pending).
job_end_time() {
    local end
    end=$(squeue -h -j "$1" -o '%e' 2>/dev/null | head -n1) || true
    [[ "${end}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2} ]] || return 0
    end="${end/T/ }"
    echo "${end:0:16}"
}

# "Session ends at ... (time limit)", or nothing if the end is not known.
end_line() {
    local end
    end=$(job_end_time "$1")
    if [[ -n "${end}" ]]; then
        echo "Session ends at ${end} (time limit); save your work before then."
    fi
}

# --------------------------------------------------------------------------
# Job mode: runs on the compute node
# --------------------------------------------------------------------------

# Make the 'module' command available in a non-interactive batch shell.
init_modules() {
    type module >/dev/null 2>&1 && return 0
    local init
    for init in /etc/profile.d/lmod.sh /etc/profile.d/modules.sh \
        /usr/share/lmod/lmod/init/bash /usr/share/Modules/init/bash; do
        if [[ -r "${init}" ]]; then
            set +u
            # shellcheck source=/dev/null
            source "${init}"
            set -u
            break
        fi
    done
    type module >/dev/null 2>&1
}

# Find the directory of the original script when running as a batch job
# (Slurm runs a spooled copy, so $0 does not point at it).
job_script_dir() {
    if [[ -n "${LJ_SCRIPT_DIR:-}" ]]; then
        echo "${LJ_SCRIPT_DIR}"
        return
    fi
    local cmd
    [[ -n "${SLURM_JOB_ID:-}" ]] || return 0
    cmd=$(scontrol show job "${SLURM_JOB_ID}" 2>/dev/null \
        | grep -o 'Command=[^ ]*' | head -n1 | cut -d= -f2-) || true
    if [[ -n "${cmd}" && -e "${cmd}" ]]; then
        dirname "$(readlink -f "${cmd}")"
    fi
}

# Pick a random TCP port that nothing on this node is listening on.
pick_port() {
    local port _
    for _ in $(seq 1 50); do
        port=$(shuf -i 8000-9999 -n 1)
        if ! command -v ss >/dev/null 2>&1 \
            || ! ss -Htln "sport = :${port}" 2>/dev/null | grep -q .; then
            echo "${port}"
            return 0
        fi
    done
    return 1
}

# Print the ssh config a user needs to reach this node through the login host.
print_ssh_config() {
    local user="$1" login="$2" node="$3"
    local pattern="${LJ_SSH_HOST_PATTERN:-${node}}"
    cat <<EOF
One-time setup: add this to ~/.ssh/config on your local machine:
  Host ${pattern}
      User ${user}
      ProxyJump ${user}@${login}
EOF
}

# Stop this user's VS Code server processes on this node. Used when the
# holding job ends, because without pam_slurm_adopt the SSH session is not
# part of the job and would otherwise keep running.
stop_vscode_server() {
    # Match on the executable path, not the command line, so only the VS Code
    # server itself is stopped (not, say, a shell or grep that mentions it).
    # Terminals it started get SIGHUP when the server exits.
    local pid exe count=0
    for pid in $(pgrep -u "$(id -un)" 2>/dev/null); do
        exe=$(readlink "/proc/${pid}/exe" 2>/dev/null) || continue
        if [[ "${exe}" == */.vscode-server/* ]] && kill "${pid}" 2>/dev/null; then
            count=$((count + 1))
        fi
    done
    echo "$(date '+%F %T') Job ending: stopped ${count} VS Code server process(es) on $(hostname -s)."
}

vscode_job() {
    local node user login
    node=$(hostname -s)
    user=$(id -un)
    login="${LJ_LOGIN_HOST:-${SLURM_SUBMIT_HOST:-$(hostname -f)}}"

    # Clean up however the job ends (scancel, time limit, or error).
    trap 'exit 0' TERM INT
    trap 'stop_vscode_server' EXIT

    cat <<EOF
==================== ${PROG} ${LJ_VERSION} (VS Code) ====================
Job ${SLURM_JOB_ID} is holding ${node} for VS Code Remote-SSH.

$(print_ssh_config "${user}" "${login}" "${node}")

Then in VS Code: Remote-SSH: Connect to Host... and enter ${node}

When this job ends (scancel ${SLURM_JOB_ID} or the time limit), VS Code
server processes on ${node} are stopped, so save your work first.
$(end_line "${SLURM_JOB_ID}")
========================================================================
VS Code session ready on ${node}
EOF

    # Hold the node until cancelled or timed out. Waiting on a background
    # sleep lets the TERM trap run straight away.
    sleep infinity &
    LJ_HOLD_PID=$!
    trap 'kill "${LJ_HOLD_PID}" 2>/dev/null; stop_vscode_server' EXIT
    wait "${LJ_HOLD_PID}"
}

job_main() {
    local arg
    for arg in "$@"; do
        [[ "${arg}" == --vscode ]] && LJ_MODE=vscode
    done

    # When started by the launcher, everything is already resolved and
    # exported. When submitted with plain sbatch, read the config here.
    if [[ -z "${LJ_FROM_LAUNCHER:-}" ]]; then
        load_config "$(job_script_dir)"
    fi

    # The log will hold Jupyter's access token. Make it private to the user,
    # since it may be in a shared directory (e.g. a plain sbatch from a
    # project folder) and other users on the node can reach 127.0.0.1.
    local log
    log=$(job_log_path "${SLURM_JOB_ID:-}")
    if [[ -n "${log}" && -f "${log}" ]]; then
        chmod 600 "${log}" || die "could not make ${log} private; not starting"
    fi

    if [[ "${LJ_MODE:-jupyter}" == vscode ]]; then
        vscode_job
        return
    fi

    if ! command -v jupyter-lab >/dev/null 2>&1; then
        [[ -n "${LJ_MODULE}" ]] \
            || die "jupyter-lab is not on PATH and no module is configured (set LJ_MODULE or use -M)"
        init_modules || die "cannot find the 'module' command on $(hostname -s)"
        set +eu
        [[ -n "${LJ_MODULEPATH}" ]] && module use "${LJ_MODULEPATH}"
        module load "${LJ_MODULE}"
        set -eu
        command -v jupyter-lab >/dev/null 2>&1 \
            || die "jupyter-lab not found after 'module load ${LJ_MODULE}'"
    fi

    local port node user login
    port=$(pick_port) || die "could not find a free port on $(hostname -s)"
    node=$(hostname -s)
    user=$(id -un)
    login="${LJ_LOGIN_HOST:-${SLURM_SUBMIT_HOST:-$(hostname -f)}}"

    cat <<EOF
==================== ${PROG} ${LJ_VERSION} ====================
Job ${SLURM_JOB_ID} on ${node}, port ${port}
Environment: ${CONDA_PREFIX:-$(dirname "$(dirname "$(command -v jupyter-lab)")")}

1. On your local machine, open the tunnel (leave it running):
  ssh -J ${user}@${login} ${user}@${node} -L ${port}:127.0.0.1:${port} -N
  Remove -N if you want a shell too.

2. Open the URL with the token that Jupyter prints below, using localhost
   in place of 127.0.0.1 (port ${port}).

$(end_line "${SLURM_JOB_ID}")
Stop the job when finished: scancel ${SLURM_JOB_ID}
================================================================
EOF

    local idle_args=()
    if [[ "${LJ_IDLE_TIMEOUT:-0}" =~ ^[0-9]+$ ]] && (( LJ_IDLE_TIMEOUT > 0 )); then
        local secs=$(( LJ_IDLE_TIMEOUT * 60 ))
        echo "Idle shutdown: on, after ${LJ_IDLE_TIMEOUT} minutes with no activity."
        # Cull idle kernels and terminals, then shut the server (and so the
        # job) down once nothing is running and nobody is connected.
        idle_args=(
            --MappingKernelManager.cull_idle_timeout="${secs}"
            --MappingKernelManager.cull_interval=300
            --TerminalManager.cull_inactive_timeout="${secs}"
            --TerminalManager.cull_interval=300
            --ServerApp.shutdown_no_activity_timeout="${secs}"
        )
    fi

    exec jupyter-lab --no-browser --ip=127.0.0.1 --port="${port}" \
        ${idle_args[@]+"${idle_args[@]}"}
}

# --------------------------------------------------------------------------
# Launcher mode: runs on the login node
# --------------------------------------------------------------------------

find_url() {
    # The URL Jupyter prints, with its hex token (or none, if the user turned
    # token auth off). The job's own header deliberately contains no URL.
    grep -oE 'http://(127\.0\.0\.1|localhost):[0-9]+/lab(\?token=[0-9a-f]+)?' "$1" 2>/dev/null \
        | head -n1 | sed 's#http://127\.0\.0\.1:#http://localhost:#' || true
}

# The user's jupyter and vscode jobs, one "jobid|name|state|node|left|end"
# line each.
my_sessions() {
    squeue -h -u "$(id -un)" -o '%i|%j|%T|%N|%L|%e' 2>/dev/null \
        | awk -F'|' '$2 == "jupyter" || $2 == "vscode"' || true
}

# Cancel one session (by job ID, or the only one), or all of them.
stop_sessions() {
    local target="$1" sessions count jobid name
    sessions=$(my_sessions)
    count=$(grep -c . <<<"${sessions}" || true)

    if [[ "${target}" == all ]]; then
        if (( count == 0 )); then
            echo "No running jupyter or vscode sessions."
            return 0
        fi
        while IFS='|' read -r jobid name _; do
            scancel "${jobid}" && echo "Stopped job ${jobid} (${name})."
        done <<<"${sessions}"
        return 0
    fi

    if [[ -z "${target}" ]]; then
        case "${count}" in
            0) echo "No running jupyter or vscode sessions."; return 0 ;;
            1) target="${sessions%%|*}" ;;
            *)
                echo "You have ${count} sessions; say which one to stop:" >&2
                while IFS='|' read -r jobid name _; do
                    echo "  ${PROG} --stop ${jobid}    (${name})" >&2
                done <<<"${sessions}"
                echo "or stop them all with: ${PROG} --stop-all" >&2
                return 1
                ;;
        esac
    fi

    # Only cancel the user's own launch_jupyter sessions.
    name=$(awk -F'|' -v id="${target}" '$1 == id {print $2}' <<<"${sessions}")
    [[ -n "${name}" ]] \
        || die "job ${target} is not one of your jupyter or vscode sessions (see ${PROG} --list)"
    scancel "${target}" && echo "Stopped job ${target} (${name})."
}

# Show the user's running sessions with their connection details.
list_sessions() {
    local found=0 jobid name state node left end log url ssh_cmd
    while IFS='|' read -r jobid name state node left end; do
        [[ -n "${jobid}" ]] || continue
        found=1
        log=$(job_log_path "${jobid}")
        echo "Job ${jobid} (${name}) ${state,,} on ${node:-?}, time left ${left}"
        if [[ "${end:-}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then
            end="${end/T/ }"
            echo "  ends:    ${end:0:16} (time limit)"
        fi
        [[ -n "${log}" ]] && echo "  log: ${log}"
        if [[ "${state}" != RUNNING ]]; then
            :
        elif [[ "${name}" == vscode ]]; then
            echo "  VS Code: Remote-SSH: Connect to Host... and enter ${node}"
        else
            ssh_cmd=$(grep -E '^\s+ssh -J ' "${log}" 2>/dev/null | head -n1 | sed 's/^\s*//' || true)
            url=$(find_url "${log}")
            [[ -n "${ssh_cmd}" ]] && bold "  tunnel:  ${ssh_cmd}"
            [[ -n "${url}" ]] && bold "  browser: ${url}"
        fi
        echo
    done < <(my_sessions)
    (( found )) || echo "No running jupyter or vscode sessions."
}

# Check that option $1 was given a value ($2), and say how if not.
need_value() {
    local example
    case "$1" in
        -c | --cpus) example=8 ;;
        -m | --mem) example=32G ;;
        -t | --time) example=4:00:00 ;;
        -p | --partition) example=main ;;
        -M | --module) example=python/jupyter ;;
        -w | --wait) example=600 ;;
        -i | --idle-timeout) example=60 ;;
        *) example=VALUE ;;
    esac
    if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        die "$1 needs a value, e.g. $1 ${example}"
    fi
}

launcher_main() {
    local script_path script_dir
    script_path=$(readlink -f "${BASH_SOURCE[0]}")
    script_dir=$(dirname "${script_path}")
    LJ_SCRIPT_HOME="${script_dir}"   # shown in --help
    load_config "${script_dir}"

    local extra=() mode=jupyter
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vscode) mode=vscode; shift ;;
            -c | --cpus) need_value "$@"; LJ_CPUS="$2"; shift 2 ;;
            -m | --mem) need_value "$@"; LJ_MEM="$2"; shift 2 ;;
            -t | --time) need_value "$@"; LJ_TIME="$2"; shift 2 ;;
            -p | --partition) need_value "$@"; LJ_PARTITION="$2"; shift 2 ;;
            -M | --module) need_value "$@"; LJ_MODULE="$2"; shift 2 ;;
            -w | --wait) need_value "$@"; LJ_WAIT="$2"; shift 2 ;;
            -i | --idle-timeout) need_value "$@"; LJ_IDLE_TIMEOUT="$2"; shift 2 ;;
            -l | --list) list_sessions; exit 0 ;;
            -s | --stop)
                if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
                    stop_sessions "$2"
                elif [[ -n "${2:-}" && "$2" != -* ]]; then
                    die "--stop takes a job ID (a number), not '$2'"
                else
                    stop_sessions ""
                fi
                exit $?
                ;;
            --stop-all) stop_sessions all; exit $? ;;
            -h | --help) usage; exit 0 ;;
            -V | --version) echo "${PROG} ${LJ_VERSION}"; exit 0 ;;
            --) shift; extra=("$@"); break ;;
            -*) die "unknown option '$1' (see ${PROG} --help)" ;;
            *) die "unexpected argument '$1' (see ${PROG} --help)" ;;
        esac
    done

    command -v sbatch >/dev/null 2>&1 || die "sbatch not found; run this on a Slurm login node"
    if [[ "${mode}" == jupyter ]] && ! command -v jupyter-lab >/dev/null 2>&1 \
        && [[ -z "${LJ_MODULE}" ]]; then
        die "jupyter-lab is not on PATH and no module is configured; activate an environment with JupyterLab or use -M <module>"
    fi
    mkdir -p "${LJ_LOG_DIR}"

    # Hand the resolved settings to the job.
    export LJ_FROM_LAUNCHER=1 LJ_SCRIPT_DIR="${script_dir}" LJ_MODE="${mode}"
    export LJ_MODULE LJ_MODULEPATH LJ_LOGIN_HOST LJ_SSH_HOST_PATTERN LJ_IDLE_TIMEOUT

    local submit jobid
    submit=$(sbatch --parsable --export=ALL \
        --job-name="${mode}" \
        --partition="${LJ_PARTITION}" \
        --cpus-per-task="${LJ_CPUS}" \
        --mem="${LJ_MEM}" \
        --time="${LJ_TIME}" \
        --output="${LJ_LOG_DIR}/jupyter-%j.log" \
        ${extra[@]+"${extra[@]}"} \
        "${script_path}") || die "sbatch failed"
    jobid="${submit%%;*}"
    local log="${LJ_LOG_DIR}/jupyter-${jobid}.log"

    echo "Submitted job ${jobid}: ${LJ_CPUS} CPUs, ${LJ_MEM}, ${LJ_TIME} on ${LJ_PARTITION}"
    echo "Log: ${log}"

    # shellcheck disable=SC2064
    trap "on_interrupt ${jobid} '${log}'" INT

    local start=${SECONDS} last_reason="" line state reason url
    while true; do
        line=$(squeue -h -j "${jobid}" -o '%T|%r' 2>/dev/null || true)
        state="${line%%|*}"
        reason="${line#*|}"
        if [[ "${mode}" == vscode ]] && grep -q '^VS Code session ready on ' "${log}" 2>/dev/null; then
            local node
            node=$(grep -m1 '^VS Code session ready on ' "${log}" | awk '{print $NF}')
            echo
            print_ssh_config "$(id -un)" "${LJ_LOGIN_HOST:-$(hostname -f)}" "${node}"
            echo
            bold "Then in VS Code: Remote-SSH: Connect to Host... and enter ${node}"
            echo
            echo "VS Code on ${node} is stopped when the job ends, so save your work first."
            end_line "${jobid}"
            echo "Stop the job when finished: ${PROG} --stop ${jobid}"
            return 0
        fi

        url=$(find_url "${log}")
        if [[ "${mode}" == jupyter && -n "${url}" ]]; then
            echo
            grep -E '^\s+ssh -J ' "${log}" | head -n1 | sed 's/^\s*//' | {
                read -r ssh_cmd
                echo "1. On your local machine, open the tunnel (leave it running):"
                bold "   ${ssh_cmd}"
                echo "   Remove -N if you want a shell too."
            }
            echo "2. Then open in your browser:"
            bold "   ${url}"
            echo
            end_line "${jobid}"
            echo "Stop the job when finished: ${PROG} --stop ${jobid}"
            return 0
        fi

        if [[ -z "${line}" || "${state}" =~ ^(COMPLETED|FAILED|CANCELLED|TIMEOUT|NODE_FAIL|OUT_OF_MEMORY|PREEMPTED)$ ]]; then
            echo >&2
            echo "${PROG}: job ${jobid} ended before it was ready. Last lines of ${log}:" >&2
            tail -n 20 "${log}" >&2 2>/dev/null || echo "(no log written)" >&2
            exit 1
        fi

        if [[ "${state}" == PENDING && "${reason}" != "${last_reason}" && "${reason}" != None ]]; then
            echo "Waiting in queue (reason: ${reason})..."
            last_reason="${reason}"
        fi

        if (( SECONDS - start > LJ_WAIT )); then
            echo
            echo "Not ready after ${LJ_WAIT}s; the job is still ${state,,}."
            echo "The connection details will appear in ${log}"
            echo "Cancel with: ${PROG} --stop ${jobid}"
            return 0
        fi
        sleep 3
    done
}

on_interrupt() {
    local jobid="$1" log="$2" answer
    echo
    if ! read -r -p "Cancel job ${jobid}? [Y/n] " answer </dev/tty; then
        answer=y
    fi
    case "${answer}" in
        n | N | no | NO)
            echo "Leaving job ${jobid} running. Connection details will be in ${log}"
            ;;
        *)
            scancel "${jobid}" && echo "Cancelled job ${jobid}."
            ;;
    esac
    exit 130
}

# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

if [[ "${1:-}" == "--job" ]] \
    || [[ -n "${SLURM_JOB_ID:-}" && "$(basename "$0")" == "slurm_script" ]]; then
    job_main "$@"
else
    launcher_main "$@"
fi
